[Unit]
Description=Badizo HFM001 private HTTPS proxy
Requires=wg-quick@wg-badizo.service
PartOf=wg-quick@wg-badizo.service
After=network-online.target wg-quick@wg-badizo.service

[Service]
Type=simple
ExecStartPre=/usr/sbin/nginx -t -c /etc/badizo-network/nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/badizo-network/nginx.conf -g "daemon off;"
ExecReload=/usr/sbin/nginx -c /etc/badizo-network/nginx.conf -s reload
Restart=on-failure
RestartSec=3
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/nginx /run /var/lib/nginx
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_CHOWN CAP_DAC_READ_SEARCH

[Install]
WantedBy=multi-user.target
